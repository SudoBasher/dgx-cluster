# {{ ansible_managed }}
auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9096
  log_level: warn

common:
  path_prefix: /loki
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

storage_config:
  aws:
    bucketnames: {{ obs_bucket }}
    region: {{ obs_region }}
    s3forcepathstyle: false
  tsdb_shipper:
    active_index_directory: /loki/tsdb-index
    cache_location: /loki/tsdb-cache

schema_config:
  configs:
    - from: 2026-01-01
      store: tsdb
      object_store: aws
      schema: v13
      index:
        prefix: loki_index_
        period: 24h

limits_config:
  retention_period: {{ obs_retention_5m }}
  # 1s-resolution hosts can burst; the defaults are too tight for that.
  ingestion_rate_mb: 32
  ingestion_burst_size_mb: 64
  max_query_lookback: {{ obs_retention_5m }}

  # Loki's OTLP endpoint promotes only a fixed default set of resource
  # attributes to stream labels, and "node" is not among them. Without this the
  # only label on a log stream is service_name, so logs cannot be filtered by
  # host and {node="spark1"} silently matches nothing.
  otlp_config:
    resource_attributes:
      attributes_config:
        - action: index_label
          attributes:
            - node
            - host.name

compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  delete_request_store: aws
