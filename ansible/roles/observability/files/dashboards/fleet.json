        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}",
          "legendFormat": "{{node}}",
          "refId": "A",
          "editorMode": "code",
