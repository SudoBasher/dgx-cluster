    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "NetBird management server's own log stream: peer connections, relay activity, and authentication/authorization events for the VPN itself - distinct from sshd host login to netbird-cp, shown separately.",
      "fieldConfig": {
        "defaults": {
