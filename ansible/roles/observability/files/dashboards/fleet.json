      "id": 12,
      "panels": [],
      "title": "Security",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "sshd authentication events from both Sparks: accepted/failed logins, session open/close.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No auth events in this window"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "id": 13,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service_name=\"ssh.service\"} | node =~ \"spark1|spark2\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "SSH auth \u2014 Sparks",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "sshd authentication events on the VPN control-plane node. This is host login to netbird-cp, not NetBird's own dashboard/API auth.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No auth events in this window"
        },
        "overrides": []
