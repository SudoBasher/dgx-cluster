    {
      "id": 10,
      "type": "timeseries",
      "title": "200GbE Spark Interconnect",
      "description": "PHY counters, actual bytes on the wire. One host path saturates near 112 Gb/s, both together near 196.",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "rate(node_ethtool_transmitted_bytes_phy{device=\"enp1s0f0np0\"}[1m])*8",
          "legendFormat": "tx {{node}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "rate(node_ethtool_received_bytes_phy{device=\"enp1s0f0np0\"}[1m])*8",
          "legendFormat": "rx {{node}}",
          "refId": "B",
          "editorMode": "code",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
