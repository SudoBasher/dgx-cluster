            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Primary NIC",
      "description": "Primary/default-route interface on every host - enP7s7 on the Sparks, ens5 on the AWS instances.",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "rate(node_network_transmit_bytes_total{device=~\"enP7s7|ens5\"}[1m])*8",
          "legendFormat": "tx {{node}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "thanos"
          },
          "expr": "rate(node_network_receive_bytes_total{device=~\"enP7s7|ens5\"}[1m])*8",
          "legendFormat": "rx {{node}}",
          "refId": "B",
