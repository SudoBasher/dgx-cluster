    {
      "id": 21,
      "type": "timeseries",
      "title": "Requests in view",
      "description": "When traffic actually happened in the selected time range. If this is flat at zero, every panel below is correctly empty - the cluster had no requests in view, not a broken dashboard. Widen the time range (top right) if you expected to see something.",
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 5
