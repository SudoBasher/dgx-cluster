{{ ansible_managed | comment }}
# Regenerate with: ansible-playbook site.yml --limit {{ inventory_hostname }}
# Contains the JWT signing key; keep mode 0600.

## Auth: tokens come from Bifrost, never from a login here
MCP_ENABLE_OAUTH21=true
EXTERNAL_OAUTH21_PROVIDER=true
GOOGLE_OAUTH_CLIENT_ID={{ google_oauth_client_id }}
# Signs this server's own JWTs. Without it the server would need the client
# secret, which only Bifrost has to hold.
FASTMCP_SERVER_AUTH_GOOGLE_JWT_SIGNING_KEY={{ _wmcp_jwt_key }}

## No disk writes: no credential files, no session store
WORKSPACE_MCP_STATELESS_MODE=true

## Listener
WORKSPACE_MCP_HOST=0.0.0.0
WORKSPACE_MCP_PORT={{ wmcp_port }}
WORKSPACE_MCP_BASE_URI=http://{{ wmcp_container_name }}
# DNS-rebinding guard: only requests addressed to the container name pass.
WORKSPACE_MCP_ALLOWED_HOSTS={{ wmcp_container_name }}

## Tools
TOOLS={{ wmcp_tools }}
TOOL_TIER={{ wmcp_tool_tier }}
WORKSPACE_MCP_READ_ONLY={{ 'true' if wmcp_read_only else 'false' }}
