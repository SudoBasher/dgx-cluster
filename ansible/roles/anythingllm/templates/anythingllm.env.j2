{{ ansible_managed | comment }}
# Regenerate with: ansible-playbook site.yml --limit {{ inventory_hostname }}
# Contains JWT_SECRET; keep mode 0600.

SERVER_PORT=3001
STORAGE_DIR=/app/server/storage
JWT_SECRET={{ _allm_jwt }}

{% if allm_llm_provider | length > 0 %}
LLM_PROVIDER={{ allm_llm_provider }}
GENERIC_OPEN_AI_BASE_PATH={{ allm_llm_base_path }}
GENERIC_OPEN_AI_MODEL_PREF={{ allm_llm_model }}
GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT={{ allm_llm_token_limit }}
GENERIC_OPEN_AI_API_KEY={{ allm_llm_api_key }}
{% endif %}
{% for k, v in allm_extra_env.items() %}
{{ k }}={{ v }}
{% endfor %}
