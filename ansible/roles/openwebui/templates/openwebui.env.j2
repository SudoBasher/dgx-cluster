{{ ansible_managed | comment }}
# Regenerate with: ansible-playbook site.yml --limit {{ inventory_hostname }}
# Contains WEBUI_SECRET_KEY and the vLLM key; keep mode 0600.

## Sessions
# Fixed, not generated by the container. Unset, start.sh writes a fresh key to
# /app/backend/.webui_secret_key, outside the data volume, so every restart of
# this --rm container would log everyone out.
WEBUI_SECRET_KEY={{ _owui_secret }}

## Persistence (see owui_persistent_config in the role defaults)
ENABLE_PERSISTENT_CONFIG={{ 'True' if owui_persistent_config else 'False' }}

## LLM connection: vLLM only, no Ollama
ENABLE_OLLAMA_API=False
OPENAI_API_BASE_URLS={{ owui_llm_base_url }}
OPENAI_API_KEYS={{ owui_llm_api_key }}
{% if owui_default_model | length > 0 %}
DEFAULT_MODELS={{ owui_default_model }}
{% endif %}

## Branding
{% if owui_name | length > 0 %}
WEBUI_NAME={{ owui_name }}
{% endif %}

## Extra
{% for k, v in owui_extra_env.items() %}
{{ k }}={{ v }}
{% endfor %}
