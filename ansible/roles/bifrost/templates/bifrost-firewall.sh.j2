#!/bin/bash
# {{ ansible_managed }}
# Restricts who may reach the Bifrost published port. Same approach as
# vllm-firewall: DOCKER-USER, because published-port traffic is DNATed and
# forwarded and never traverses INPUT.
set -euo pipefail

## Settings
TAG="bifrost-acl"
CPORT={{ bifrost_port }}   # container port; equals the host port by design

## Remove rules from a previous run, so reruns are idempotent
existing="$(iptables-save -t filter 2>/dev/null | grep -- "--comment \"${TAG}\"" || true)"
if [ -n "${existing}" ]; then
  printf '%s\n' "${existing}" | sed 's/^-A /-D /' | while read -r rule; do
    # shellcheck disable=SC2086
    iptables -t filter $rule 2>/dev/null || true
  done
fi

{% if bifrost_restrict_network %}
## Insert in reverse: final order is established, allowed CIDRs, drop
iptables -I DOCKER-USER 1 -p tcp --dport "${CPORT}" \
    -m comment --comment "${TAG}" -j DROP
{% for cidr in bifrost_allowed_cidrs %}
iptables -I DOCKER-USER 1 -p tcp --dport "${CPORT}" -s {{ cidr }} \
    -m comment --comment "${TAG}" -j RETURN
{% endfor %}
iptables -I DOCKER-USER 1 -p tcp --dport "${CPORT}" \
    -m conntrack --ctstate RELATED,ESTABLISHED \
    -m comment --comment "${TAG}" -j RETURN
{% endif %}

exit 0
