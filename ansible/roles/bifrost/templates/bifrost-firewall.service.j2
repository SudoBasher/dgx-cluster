{{ ansible_managed | comment }}
[Unit]
Description=Restrict source networks allowed to reach Bifrost
# Docker rebuilds its chains when it starts, which discards these rules.
After=docker.service
Requires=docker.service
Before={{ bifrost_service_name }}.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/{{ bifrost_service_name }}-firewall

[Install]
WantedBy=multi-user.target
