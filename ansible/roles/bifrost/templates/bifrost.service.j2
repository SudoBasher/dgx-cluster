{{ ansible_managed | comment }}
# Bifrost LLM gateway on port {{ bifrost_port }}.
# Regenerate with: ansible-playbook site.yml --limit {{ inventory_hostname }}

[Unit]
Description=Bifrost LLM gateway
Documentation=https://docs.getbifrost.ai
After=docker.service network-online.target {{ bifrost_service_name }}-firewall.service
Requires=docker.service
Wants=network-online.target
# Not a hard dependency on vLLM: the gateway should come up and report the
# backend as down rather than refuse to start.
After={{ ms_service_name | default('vllm') }}.service

[Service]
Type=simple
Restart=always
RestartSec=15
TimeoutStartSec=300
TimeoutStopSec=60

# A stale container from an unclean shutdown would block the name.
ExecStartPre=-/usr/bin/docker rm -f {{ bifrost_container_name }}

ExecStart=/usr/bin/docker run \
    --rm \
    --name {{ bifrost_container_name }} \
    --publish {{ bifrost_publish_address }}:{{ bifrost_port }}:{{ bifrost_port }} \
    --volume {{ bifrost_data_dir }}:/app/data \
    --env-file {{ bifrost_base_dir }}/bifrost.env \
    --add-host host.docker.internal:host-gateway \
{% if bifrost_docker_network | length > 0 %}
    --network {{ bifrost_docker_network }} \
{% endif %}
    {{ bifrost_image }}

ExecStop=/usr/bin/docker stop --time 30 {{ bifrost_container_name }}

[Install]
WantedBy=multi-user.target
