{{ ansible_managed | comment }}
# Regenerate with: ansible-playbook site.yml --limit {{ inventory_hostname }}
# Every secret config.json refers to as env.VAR. Keep mode 0600.

## Listener
APP_HOST=0.0.0.0
APP_PORT={{ bifrost_port }}
LOG_LEVEL=info

## Admin and bootstrap
BIFROST_ADMIN_USERNAME={{ bifrost_admin_username }}
BIFROST_ADMIN_PASSWORD={{ bifrost_admin_password }}
BIFROST_SETUP_TOKEN={{ bifrost_setup_token }}
BIFROST_ENCRYPTION_KEY={{ bifrost_encryption_key }}

## Backend credential (the "bifrost" entry in .secrets/vllm-keys.yml)
BIFROST_VLLM_KEY={{ bifrost_vllm_key }}

## Virtual keys, one per client
{% for vk in bifrost_virtual_keys | default([]) %}
BIFROST_VK_{{ vk.id | upper | regex_replace('[^A-Z0-9]', '_') | regex_replace('^VK_', '') }}={{ vk.value }}
{% endfor %}

## Google OAuth client, for per-user MCP logins (.secrets/google-oauth.yml)
{% if google_oauth_client_id | default('') | length > 0 %}
BIFROST_GOOGLE_CLIENT_ID={{ google_oauth_client_id }}
BIFROST_GOOGLE_CLIENT_SECRET={{ google_oauth_client_secret }}
{% endif %}
