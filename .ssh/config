# DGX Spark cluster — use with:  ssh -F .ssh/config spark1
#
# IdentitiesOnly/IdentityAgent keep ssh from falling back to ~/.ssh or the
# agent: this repo's key is the only identity ever offered.

Host spark1 spark-a01a spark-a01a.tommyslab
    HostName spark-a01a.tommyslab
    User claude

Host spark2 spark-9d80 spark-9d80.tommyslab
    HostName spark-9d80.tommyslab
    User claude
 
Host spark1 spark2 spark-a01a spark-9d80 spark-a01a.tommyslab spark-9d80.tommyslab
    IdentityFile /home/user/storage/development/github/sudobasher/dgx-cluster/.ssh/dgx_spark
    IdentitiesOnly yes
    IdentityAgent none
    UserKnownHostsFile /home/user/storage/development/github/sudobasher/dgx-cluster/.ssh/known_hosts
    ServerAliveInterval 30
    ServerAliveCountMax 4

# AWS. Uses the DNS name rather than the EIP so a rebuild does not need a
# config edit.
Host netbird-cp
    HostName vpn.isc-spectro-sbx.click
    User ubuntu
    IdentityFile /home/user/storage/development/github/sudobasher/dgx-cluster/.ssh/aws_dgx
    IdentitiesOnly yes
    IdentityAgent none
    UserKnownHostsFile /home/user/storage/development/github/sudobasher/dgx-cluster/.ssh/known_hosts
    ServerAliveInterval 30
    ServerAliveCountMax 4

# Private subnet. Reached via netbird-cp until they join the VPN, after which
# their overlay addresses work directly.
Host obs-write
    HostName 10.200.10.116
    ProxyJump netbird-cp
Host obs-read
    HostName 10.200.10.245
    ProxyJump netbird-cp
Host obs-write obs-read
    User ubuntu
    IdentityFile /home/user/storage/development/github/sudobasher/dgx-cluster/.ssh/aws_dgx
    IdentitiesOnly yes
    IdentityAgent none
    UserKnownHostsFile /home/user/storage/development/github/sudobasher/dgx-cluster/.ssh/known_hosts

# Overlay addresses. Work from anywhere on the VPN, and unlike the .tommyslab
# names they do not depend on the local eno2 interface being up.
Host spark1-vpn
    HostName 100.123.96.149
Host spark2-vpn
    HostName 100.123.5.235
Host spark1-vpn spark2-vpn
    User claude
    IdentityFile /home/user/storage/development/github/sudobasher/dgx-cluster/.ssh/dgx_spark
    IdentitiesOnly yes
    IdentityAgent none
    UserKnownHostsFile /home/user/storage/development/github/sudobasher/dgx-cluster/.ssh/known_hosts
    ServerAliveInterval 30
    ServerAliveCountMax 4

